<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bishe.system.mapper.travel.BizTripApplyMapper">

    <resultMap type="com.bishe.system.domain.travel.BizTripApply" id="BizTripApplyResult">
        <result property="applyId" column="apply_id"/>
        <result property="applyNo" column="apply_no"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="deptId" column="dept_id"/>
        <result property="deptName" column="dept_name"/>
        <result property="destination" column="destination"/>
        <result property="startDate" column="start_date"/>
        <result property="endDate" column="end_date"/>
        <result property="tripDays" column="trip_days"/>
        <result property="tripReason" column="trip_reason"/>
        <result property="budgetAmount" column="budget_amount"/>
        <result property="status" column="status"/>
        <result property="approvalStep" column="approval_step"/>
        <result property="approverId" column="approver_id"/>
        <result property="approverName" column="approver_name"/>
        <result property="approveTime" column="approve_time"/>
        <result property="approveComment" column="approve_comment"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectBizTripApplyVo">
        select apply_id, apply_no, user_id, user_name, dept_id, dept_name, destination, start_date, end_date, trip_days,
               trip_reason, budget_amount, status, approval_step, approver_id, approver_name, approve_time, approve_comment,
               create_by, create_time, update_by, update_time, remark
        from biz_trip_apply
    </sql>

    <select id="selectBizTripApplyById" parameterType="Long" resultMap="BizTripApplyResult">
        <include refid="selectBizTripApplyVo"/>
        where apply_id = #{applyId}
    </select>

    <select id="selectBizTripApplyList" parameterType="com.bishe.system.domain.travel.BizTripApply" resultMap="BizTripApplyResult">
        <include refid="selectBizTripApplyVo"/>
        <where>
            <if test="applyNo != null and applyNo != ''">and apply_no like concat('%', #{applyNo}, '%')</if>
            <if test="userId != null">and user_id = #{userId}</if>
            <if test="userName != null and userName != ''">and user_name like concat('%', #{userName}, '%')</if>
            <if test="destination != null and destination != ''">and destination like concat('%', #{destination}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="params.beginTime != null and params.beginTime != ''"><![CDATA[ and date_format(create_time,'%y%m%d') >= date_format(#{params.beginTime},'%y%m%d') ]]></if>
            <if test="params.endTime != null and params.endTime != ''"><![CDATA[ and date_format(create_time,'%y%m%d') <= date_format(#{params.endTime},'%y%m%d') ]]></if>
        </where>
        order by apply_id desc
    </select>

    <insert id="insertBizTripApply" parameterType="com.bishe.system.domain.travel.BizTripApply" useGeneratedKeys="true" keyProperty="applyId">
        insert into biz_trip_apply
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="applyNo != null">apply_no,</if>
            <if test="userId != null">user_id,</if>
            <if test="userName != null">user_name,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="deptName != null">dept_name,</if>
            <if test="destination != null">destination,</if>
            <if test="startDate != null">start_date,</if>
            <if test="endDate != null">end_date,</if>
            <if test="tripDays != null">trip_days,</if>
            <if test="tripReason != null">trip_reason,</if>
            <if test="budgetAmount != null">budget_amount,</if>
            <if test="status != null">status,</if>
            <if test="approvalStep != null">approval_step,</if>
            <if test="approverId != null">approver_id,</if>
            <if test="approverName != null">approver_name,</if>
            <if test="approveTime != null">approve_time,</if>
            <if test="approveComment != null">approve_comment,</if>
            <if test="createBy != null">create_by,</if>
            create_time,
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="applyNo != null">#{applyNo},</if>
            <if test="userId != null">#{userId},</if>
            <if test="userName != null">#{userName},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="deptName != null">#{deptName},</if>
            <if test="destination != null">#{destination},</if>
            <if test="startDate != null">#{startDate},</if>
            <if test="endDate != null">#{endDate},</if>
            <if test="tripDays != null">#{tripDays},</if>
            <if test="tripReason != null">#{tripReason},</if>
            <if test="budgetAmount != null">#{budgetAmount},</if>
            <if test="status != null">#{status},</if>
            <if test="approvalStep != null">#{approvalStep},</if>
            <if test="approverId != null">#{approverId},</if>
            <if test="approverName != null">#{approverName},</if>
            <if test="approveTime != null">#{approveTime},</if>
            <if test="approveComment != null">#{approveComment},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate(),
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateBizTripApply" parameterType="com.bishe.system.domain.travel.BizTripApply">
        update biz_trip_apply
        <set>
            <if test="applyNo != null">apply_no = #{applyNo},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userName != null">user_name = #{userName},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="deptName != null">dept_name = #{deptName},</if>
            <if test="destination != null">destination = #{destination},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="tripDays != null">trip_days = #{tripDays},</if>
            <if test="tripReason != null">trip_reason = #{tripReason},</if>
            <if test="budgetAmount != null">budget_amount = #{budgetAmount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="approvalStep != null">approval_step = #{approvalStep},</if>
            <if test="approverId != null">approver_id = #{approverId},</if>
            <if test="approverName != null">approver_name = #{approverName},</if>
            <if test="approveTime != null">approve_time = #{approveTime},</if>
            <if test="approveComment != null">approve_comment = #{approveComment},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate(),
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where apply_id = #{applyId}
    </update>

    <delete id="deleteBizTripApplyById" parameterType="Long">
        delete from biz_trip_apply where apply_id = #{applyId}
    </delete>

    <delete id="deleteBizTripApplyByIds" parameterType="Long">
        delete from biz_trip_apply where apply_id in
        <foreach item="applyId" collection="array" open="(" separator="," close=")">
            #{applyId}
        </foreach>
    </delete>

</mapper>
