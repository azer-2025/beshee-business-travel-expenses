            <if test="userId != null">and user_id = #{userId}</if>
            <if test="userName != null and userName != ''">and user_name like concat('%', #{userName}, '%')</if>
            <if test="destination != null and destination != ''">and destination like concat('%', #{destination}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="payStatus != null and payStatus != ''">and pay_status = #{payStatus}</if>
            <if test="params.beginTime != null and params.beginTime != ''"><![CDATA[ and date_format(create_time,'%y%m%d') >= date_format(#{params.beginTime},'%y%m%d') ]]></if>
            <if test="params.endTime != null and params.endTime != ''"><![CDATA[ and date_format(create_time,'%y%m%d') <= date_format(#{params.endTime},'%y%m%d') ]]></if>
        </where>
