<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bishe.system.mapper.travel.BizFinancePaymentMapper">

    <resultMap type="com.bishe.system.domain.travel.BizFinancePayment" id="BizFinancePaymentResult">
        <result property="paymentId" column="payment_id"/>
        <result property="paymentNo" column="payment_no"/>
        <result property="reimburseId" column="reimburse_id"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="payAmount" column="pay_amount"/>
        <result property="payChannel" column="pay_channel"/>
        <result property="payAccount" column="pay_account"/>
        <result property="payStatus" column="pay_status"/>
        <result property="payTime" column="pay_time"/>
        <result property="voucherImage" column="voucher_image"/>
        <result property="operatorId" column="operator_id"/>
        <result property="operatorName" column="operator_name"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectBizFinancePaymentVo">
        select payment_id, payment_no, reimburse_id, user_id, user_name, pay_amount, pay_channel, pay_account,
               pay_status, pay_time, voucher_image, operator_id, operator_name,
               create_by, create_time, update_by, update_time, remark
        from biz_finance_payment
    </sql>

    <select id="selectBizFinancePaymentById" parameterType="Long" resultMap="BizFinancePaymentResult">
        <include refid="selectBizFinancePaymentVo"/>
        where payment_id = #{paymentId}
    </select>

    <select id="selectBizFinancePaymentList" parameterType="com.bishe.system.domain.travel.BizFinancePayment" resultMap="BizFinancePaymentResult">
        <include refid="selectBizFinancePaymentVo"/>
        <where>
            <if test="paymentNo != null and paymentNo != ''">and payment_no like concat('%', #{paymentNo}, '%')</if>
            <if test="reimburseId != null">and reimburse_id = #{reimburseId}</if>
            <if test="userName != null and userName != ''">and user_name like concat('%', #{userName}, '%')</if>
            <if test="payStatus != null and payStatus != ''">and pay_status = #{payStatus}</if>
            <if test="params.beginTime != null and params.beginTime != ''"><![CDATA[ and date_format(create_time,'%y%m%d') >= date_format(#{params.beginTime},'%y%m%d') ]]></if>
            <if test="params.endTime != null and params.endTime != ''"><![CDATA[ and date_format(create_time,'%y%m%d') <= date_format(#{params.endTime},'%y%m%d') ]]></if>
        </where>
        order by payment_id desc
    </select>

    <insert id="insertBizFinancePayment" parameterType="com.bishe.system.domain.travel.BizFinancePayment" useGeneratedKeys="true" keyProperty="paymentId">
        insert into biz_finance_payment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="paymentNo != null">payment_no,</if>
            <if test="reimburseId != null">reimburse_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="userName != null">user_name,</if>
            <if test="payAmount != null">pay_amount,</if>
            <if test="payChannel != null">pay_channel,</if>
            <if test="payAccount != null">pay_account,</if>
            <if test="payStatus != null">pay_status,</if>
            <if test="payTime != null">pay_time,</if>
            <if test="voucherImage != null">voucher_image,</if>
            <if test="operatorId != null">operator_id,</if>
            <if test="operatorName != null">operator_name,</if>
            <if test="createBy != null">create_by,</if>
            create_time,
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="paymentNo != null">#{paymentNo},</if>
            <if test="reimburseId != null">#{reimburseId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="userName != null">#{userName},</if>
            <if test="payAmount != null">#{payAmount},</if>
            <if test="payChannel != null">#{payChannel},</if>
            <if test="payAccount != null">#{payAccount},</if>
            <if test="payStatus != null">#{payStatus},</if>
            <if test="payTime != null">#{payTime},</if>
            <if test="voucherImage != null">#{voucherImage},</if>
            <if test="operatorId != null">#{operatorId},</if>
            <if test="operatorName != null">#{operatorName},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate(),
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateBizFinancePayment" parameterType="com.bishe.system.domain.travel.BizFinancePayment">
        update biz_finance_payment
        <set>
            <if test="paymentNo != null">payment_no = #{paymentNo},</if>
            <if test="reimburseId != null">reimburse_id = #{reimburseId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userName != null">user_name = #{userName},</if>
            <if test="payAmount != null">pay_amount = #{payAmount},</if>
            <if test="payChannel != null">pay_channel = #{payChannel},</if>
            <if test="payAccount != null">pay_account = #{payAccount},</if>
            <if test="payStatus != null">pay_status = #{payStatus},</if>
            <if test="payTime != null">pay_time = #{payTime},</if>
            <if test="voucherImage != null">voucher_image = #{voucherImage},</if>
            <if test="operatorId != null">operator_id = #{operatorId},</if>
            <if test="operatorName != null">operator_name = #{operatorName},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate(),
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where payment_id = #{paymentId}
    </update>

    <delete id="deleteBizFinancePaymentById" parameterType="Long">
        delete from biz_finance_payment where payment_id = #{paymentId}
    </delete>

    <delete id="deleteBizFinancePaymentByIds" parameterType="Long">
        delete from biz_finance_payment where payment_id in
        <foreach item="paymentId" collection="array" open="(" separator="," close=")">
            #{paymentId}
        </foreach>
    </delete>

</mapper>
